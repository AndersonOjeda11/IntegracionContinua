# Plantilla de variables de entorno.
# Copie este archivo como .env y cambie los valores:  cp .env.example .env
# El archivo .env tiene las contrasenas reales y NO se sube al repositorio (esta en .gitignore).

POSTGRES_DB=calculadora
POSTGRES_USER=calculadora
POSTGRES_PASSWORD=cambie_esta_clave

# Puerto del equipo anfitrion donde queda publicada la API.
APP_PORT=5000
