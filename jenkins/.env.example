# Plantilla de variables de Jenkins.
# Copie este archivo como jenkins/.env y cambie los valores:  cp jenkins/.env.example jenkins/.env
# El archivo jenkins/.env tiene las contrasenas reales y NO se sube al repositorio (esta en .gitignore).

# Usuario administrador de Jenkins.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambie_esta_clave

# Credencial "postgres-ci" que Jenkins guarda y que el Jenkinsfile usa en la prueba de integracion.
CI_POSTGRES_USER=calculadora
CI_POSTGRES_PASSWORD=cambie_esta_clave
